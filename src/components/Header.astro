---
import { navItems, siteMeta } from "../utils/site";

const pathname = Astro.url.pathname;

function isActive(href: string) {
  if (href === "/") {
    return pathname === "/";
  }

  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="container shell header-inner">
    <a class="brand" href="/">
      <img class="brand-logo" src="/logo.jpeg" alt="LiuJrX-Space logo" />
      <span>{siteMeta.title}</span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={["nav-link", { "nav-link-active": isActive(item.href) }]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
